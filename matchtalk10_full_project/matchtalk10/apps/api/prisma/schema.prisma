generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum MatchStatus { SCHEDULED LIVE HALF_TIME BREAK FULL_TIME POSTPONED CANCELLED ABANDONED }
enum UserRole { USER EDITOR ADMIN SUPER_ADMIN }
enum ArticleStatus { DRAFT REVIEW PUBLISHED ARCHIVED }
model User { id String @id @default(cuid()); email String @unique; passwordHash String; displayName String?; role UserRole @default(USER); createdAt DateTime @default(now()); preferences UserPreference?; activities UserActivity[]; favourites Favourite[] }
model UserPreference { id String @id @default(cuid()); userId String @unique; user User @relation(fields:[userId],references:[id],onDelete:Cascade); sports String[]; teamIds String[]; playerIds String[]; competitionIds String[]; personalizationEnabled Boolean @default(true) }
model Sport { id String @id @default(cuid()); name String @unique; slug String @unique; competitions Competition[]; teams Team[] }
model Competition { id String @id @default(cuid()); sportId String; sport Sport @relation(fields:[sportId],references:[id]); name String; countryCode String?; seasons Season[]; @@unique([sportId,name]) }
model Season { id String @id @default(cuid()); competitionId String; competition Competition @relation(fields:[competitionId],references:[id]); name String; startsAt DateTime?; endsAt DateTime?; matches Match[] }
model Team { id String @id @default(cuid()); sportId String; sport Sport @relation(fields:[sportId],references:[id]); name String; countryCode String?; @@unique([sportId,name]) }
model Player { id String @id @default(cuid()); fullName String; nationality String?; dateOfBirth DateTime? }
model Match { id String @id @default(cuid()); seasonId String; season Season @relation(fields:[seasonId],references:[id]); homeTeamId String; awayTeamId String; homeScore Int @default(0); awayScore Int @default(0); status MatchStatus @default(SCHEDULED); startsAt DateTime; period String?; clockSeconds Int?; events MatchEvent[]; updatedAt DateTime @updatedAt; @@index([startsAt,status]) }
model MatchEvent { id String @id @default(cuid()); matchId String; match Match @relation(fields:[matchId],references:[id],onDelete:Cascade); providerEventId String?; eventType String; period String?; clockSeconds Int?; teamId String?; playerId String?; payload Json; occurredAt DateTime; @@unique([matchId,providerEventId]); @@index([matchId,occurredAt]) }
model Favourite { id String @id @default(cuid()); userId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); entityType String; entityId String; @@unique([userId,entityType,entityId]) }
model Article { id String @id @default(cuid()); providerId String?; externalId String?; title String; summary String?; body String?; url String @unique; imageUrl String?; language String @default("en"); sport String?; topics String[]; entities String[]; status ArticleStatus @default(REVIEW); publishedAt DateTime?; @@index([status,publishedAt]) }
model UserActivity { id String @id @default(cuid()); userId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); articleId String; action String; dwellSeconds Int?; createdAt DateTime @default(now()); @@index([userId,createdAt]) }
model DataProvider { id String @id @default(cuid()); name String @unique; providerType String; enabled Boolean @default(false); configuration Json }
model ProviderSyncLog { id String @id @default(cuid()); providerId String; startedAt DateTime @default(now()); finishedAt DateTime?; status String; recordsReceived Int @default(0); errorMessage String? }
model AuditLog { id String @id @default(cuid()); actorUserId String?; action String; resourceType String; resourceId String?; metadata Json?; createdAt DateTime @default(now()); @@index([createdAt]) }